# ---------------------------------------------------------------------------
# BharatVoice AI - environment template.  Copy to .env and fill in.
# NEVER commit a real .env.  Every secret stays on the backend.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
APP_NAME="BharatVoice AI"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ----------------------------------------------------------
# Development default is SQLite so the app boots with zero infrastructure.
# Production / Docker uses PostgreSQL (see docker-compose.yml).
DATABASE_URL=sqlite:///./bharatvoice.db
# DATABASE_URL=postgresql+psycopg://bharatvoice:bharatvoice@localhost:5432/bharatvoice
DB_ECHO=false

# --- Redis (optional: caching, live-session state, rate limiting) ------
REDIS_URL=
CACHE_ENABLED=false

# --- Sarvam AI (PRIMARY ASR PROVIDER) ----------------------------------
# Get a key at https://dashboard.sarvam.ai . Backend-only, never in the browser.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_PATH=/speech-to-text
SARVAM_REALTIME_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_MODEL=saaras:v4
SARVAM_TIMEOUT_SECONDS=45
SARVAM_MAX_RETRIES=2
SARVAM_MONTHLY_REQUEST_BUDGET=20000   # soft guard, see ai_engine/adapters/sarvam/cost.py

# --- Alternative ASR backends (all optional) ---------------------------
WHISPER_ENABLED=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
INDICCONFORMER_ENABLED=false
INDICCONFORMER_MODEL_DIR=./models/indicconformer

# --- Multilingual adapters (optional local models) ---------------------
INDICTRANS2_ENABLED=false
INDICTRANS2_MODEL_DIR=./models/indictrans2
INDICXLIT_ENABLED=false
INDICXLIT_MODEL_DIR=./models/indicxlit
DEEPFILTERNET_ENABLED=false
SILERO_VAD_ENABLED=false
SILERO_VAD_MODEL_PATH=./models/silero_vad.onnx

# --- Demo / safety -----------------------------------------------------
# When true and no real provider is available, the API may answer with a
# clearly labelled DEMO FIXTURE transcript.  Every such response carries
# engine_status="demo_fixture" and the UI shows a badge.  Set false in prod.
DEMO_MODE=true

# --- Limits ------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_RECORDING_SECONDS=300
RATE_LIMIT_TRANSCRIBE_PER_MINUTE=30
AUDIO_RETENTION_DEFAULT=discard      # discard | 30d | 90d | keep

# --- Frontend (build-time, public values only) -------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_DEMO_UI=false
