{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BharatVoice AI",
  "version": "1.0.0",
  "identifier": "ai.bharatvoice.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BharatVoice AI",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "floating-mic",
        "title": "BharatVoice",
        "url": "index.html#/app/workspace",
        "width": 380,
        "height": 190,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 ws://localhost:8000 https: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "shortDescription": "Adaptive multilingual voice typing for India",
    "longDescription": "BharatVoice AI desktop shell: global shortcut, floating microphone and clipboard paste."
  }
}
